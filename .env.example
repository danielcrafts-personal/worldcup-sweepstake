# --- Supabase (server-only) ---------------------------------------------------
# From your Supabase project: Settings → API.
# Leave SUPABASE_URL blank for LOCAL DEV — the app falls back to a JSON file
# at .data/store.json so you can run `npm run dev` without Supabase.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Admin auth ----------------------------------------------------------------
# Password for the Settings page. Defaults to "changeme" if unset (dev only).
ADMIN_PASSWORD=changeme
# Random long string used to sign the admin session cookie (HMAC).
# Generate e.g. with: node -e "console.log(crypto.randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=dev-only-change-me

# --- football-data.org ---------------------------------------------------------
# Free API token from https://www.football-data.org/client/register
FOOTBALL_DATA_TOKEN=
# Optional: override the competition code (WC = FIFA World Cup).
FOOTBALL_DATA_COMPETITION=WC

# --- Sync auth -----------------------------------------------------------------
# Shared secret required to call /api/sync from a scheduler (Bearer token).
# Vercel Cron sends this automatically when set as an env var.
CRON_SECRET=dev-only-change-me
